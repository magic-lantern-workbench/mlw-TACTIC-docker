# Required
DB_PASSWORD=change-me-to-a-long-random-string

DB_USER=postgres
# Public hostname and protocol (https when serving TLS); used for generated URLs
TACTIC_HOSTNAME=localhost
TACTIC_PROTOCOL=http
HTTP_PORT=80
HTTPS_PORT=443

# Directory containing tls.crt and tls.key; HTTPS is enabled when both exist
TLS_CERT_DIR=./certs

# Production project, created from one of TACTIC's built-in plugins on first start.
# TACTIC_PLUGIN is a directory under src/plugins/TACTIC (for example mlw or vfx). The code
# (also the database name) and title default to the plugin name.
TACTIC_PROJECT_ENABLED=true
TACTIC_PLUGIN=mlw
# TACTIC_PROJECT_CODE=mlw
# TACTIC_PROJECT_TITLE=MLW

# Where production media is stored. Unset uses a Docker volume; set a host path for large storage.
# The path must be writable by uid 1000 (the tactic user in the container).
# TACTIC_ASSETS=/mnt/nas/tactic_assets

# TACTIC branch or tag to build. magiclantern carries the mlw plugin; pin a tag for reproducible builds.
TACTIC_REF=magiclantern

# Tuning
TACTIC_MEM_LIMIT=4g
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=768MB
PG_MAX_CONNECTIONS=200
