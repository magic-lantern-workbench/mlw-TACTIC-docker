# Required
DB_PASSWORD=change-me-to-a-long-random-string

DB_USER=postgres
# Public hostname and protocol (https when serving TLS); used for generated URLs
TACTIC_HOSTNAME=localhost
TACTIC_PROTOCOL=http
HTTP_PORT=80
HTTPS_PORT=443

# Directory containing tls.crt and tls.key; HTTPS is enabled when both exist
TLS_CERT_DIR=./certs

# VFX production project, created from TACTIC's built-in VFX plugin on first start
VFX_ENABLED=true
VFX_PROJECT_CODE=vfx
VFX_PROJECT_TITLE=VFX

# Where production media is stored. Unset uses a Docker volume; set a host path for large storage.
# The path must be writable by uid 1000 (the tactic user in the container).
# TACTIC_ASSETS=/mnt/nas/tactic_assets

# Pin to a release tag for reproducible builds
TACTIC_REF=5.0

# Tuning
TACTIC_MEM_LIMIT=4g
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=768MB
PG_MAX_CONNECTIONS=200
